{
  "info": {
    "_postman_id": "labrepair-api-v2-collection",
    "name": "LabRepair REST API Collection",
    "description": "Bộ kiểm thử tự động toàn diện RESTful API cho đồ án LabRepair (HITC) - Sinh viên: Lê Nguyễn Ngọc Duy Anh (MSSV: 2124110340)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "techToken", "value": "", "type": "string" },
    { "key": "studentToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication & Security (Xác thực JWT)",
      "item": [
        {
          "name": "1.1 Đăng nhập ADMIN -> Lấy JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('adminToken', jsonData.token);",
                  "pm.collectionVariables.set('adminToken', jsonData.token);",
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Token exists', function () { pm.expect(jsonData.token).to.not.be.empty; });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@school.edu\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "1.2 Đăng nhập KỸ THUẬT VIÊN (Technician)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('techToken', jsonData.token);",
                  "pm.test('KTV Login Success', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tech@school.edu\",\n  \"password\": \"tech123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "1.3 Đăng nhập SINH VIÊN (Student Duy Anh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('studentToken', jsonData.token);",
                  "pm.test('Student Login Success', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@school.edu\",\n  \"password\": \"student123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "2. Security Test Cases (Kiểm thử Phân quyền RBAC)",
      "item": [
        {
          "name": "2.1 Test 401 Unauthorized - Gọi API không gửi kèm Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Bảo mật thành công: Trả về mã lỗi 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/dashboard/summary", "host": ["{{baseUrl}}"], "path": ["dashboard", "summary"] }
          }
        },
        {
          "name": "2.2 Test 403 Forbidden - Sinh viên cố tình gọi API xóa phòng máy",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Bảo mật thành công: Chặn truy cập 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/rooms/1", "host": ["{{baseUrl}}"], "path": ["rooms", "1"] }
          }
        },
        {
          "name": "2.3 Test 200 OK - Admin gọi API Dashboard thống kê thành công",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin truy cập Dashboard thành công 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/summary", "host": ["{{baseUrl}}"], "path": ["dashboard", "summary"] }
          }
        }
      ]
    },
    {
      "name": "3. Computer Rooms & Equipments (Phòng máy & Thiết bị)",
      "item": [
        {
          "name": "3.1 Lấy danh sách phòng máy (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/rooms", "host": ["{{baseUrl}}"], "path": ["rooms"] }
          }
        },
        {
          "name": "3.2 Lấy danh sách thiết bị máy tính (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/equipment", "host": ["{{baseUrl}}"], "path": ["equipment"] }
          }
        },
        {
          "name": "3.3 Admin thêm phòng máy mới",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomCode\": \"PM04\",\n  \"roomName\": \"Phòng Thực Hành AI & IoT\",\n  \"location\": \"Tầng 4 - Tòa Nhà A\",\n  \"capacity\": 30,\n  \"description\": \"Phục vụ các môn học Trí tuệ nhân tạo và Vi điều khiển\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/rooms", "host": ["{{baseUrl}}"], "path": ["rooms"] }
          }
        }
      ]
    },
    {
      "name": "4. Incidents & Repair Workflow (Luồng Nghiệp vụ Sửa chữa)",
      "item": [
        {
          "name": "4.1 Sinh viên báo hỏng máy tính",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipmentId\": 1,\n  \"description\": \"Máy bị dump xanh (BSOD WHEA_UNCORRECTABLE_ERROR), bật lên kêu 3 tiếng bíp\",\n  \"priority\": \"KHAN_CAP\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/incidents", "host": ["{{baseUrl}}"], "path": ["incidents"] }
          }
        },
        {
          "name": "4.2 Kỹ thuật viên tiếp nhận sự cố",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{techToken}}" }],
            "url": { "raw": "{{baseUrl}}/incidents/1/status?status=DA_TIEP_NHAN", "host": ["{{baseUrl}}"], "path": ["incidents", "1", "status"], "query": [{ "key": "status", "value": "DA_TIEP_NHAN" }] }
          }
        },
        {
          "name": "4.3 Kỹ thuật viên sửa chữa, thay linh kiện & TỰ ĐỘNG TRỪ KHO",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{techToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"incidentId\": 1,\n  \"actionType\": \"THAY_THE\",\n  \"note\": \"Đã thay thế thanh RAM 8GB DDR4 Kingston bị lỗi dump xanh. Test Memtest86 100% pass, máy hoạt động ổn định.\",\n  \"durationMinutes\": 30,\n  \"partsUsed\": [\n    {\n      \"sparePartId\": 1,\n      \"quantityUsed\": 1,\n      \"note\": \"Lắp vào khe cắm RAM 1\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/repair-histories", "host": ["{{baseUrl}}"], "path": ["repair-histories"] }
          }
        }
      ]
    },
    {
      "name": "5. Spare Parts Inventory (Kho linh kiện)",
      "item": [
        {
          "name": "5.1 Lấy toàn bộ danh sách kho linh kiện",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{techToken}}" }],
            "url": { "raw": "{{baseUrl}}/spare-parts", "host": ["{{baseUrl}}"], "path": ["spare-parts"] }
          }
        },
        {
          "name": "5.2 Cảnh báo các linh kiện sắp hết hàng (stock <= minStock)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{techToken}}" }],
            "url": { "raw": "{{baseUrl}}/spare-parts/low-stock", "host": ["{{baseUrl}}"], "path": ["spare-parts", "low-stock"] }
          }
        }
      ]
    },
    {
      "name": "6. Dashboard Analytics (Báo cáo Thống kê)",
      "item": [
        {
          "name": "6.1 Tổng quan thống kê (KPIs)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/summary", "host": ["{{baseUrl}}"], "path": ["dashboard", "summary"] }
          }
        },
        {
          "name": "6.2 Thống kê chi phí sửa chữa theo phòng máy",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/room-costs", "host": ["{{baseUrl}}"], "path": ["dashboard", "room-costs"] }
          }
        },
        {
          "name": "6.3 Top thiết bị hỏng nhiều nhất",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/top-failures?limit=5", "host": ["{{baseUrl}}"], "path": ["dashboard", "top-failures"], "query": [{ "key": "limit", "value": "5" }] }
          }
        }
      ]
    }
  ]
}
